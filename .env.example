# Split-Flap — Docker configuration overrides.
#
# Everything here is OPTIONAL. With no .env file, the defaults below apply.
# To customize: `cp .env.example .env`, edit, then
# `docker compose pull && docker compose up -d`.

# Host port the display + API are served on. The container always listens on
# 3001 internally; this only changes the port you open in a browser.
#
# 80 is the default so the URL needs no port. Binding it takes no extra
# privilege: the host side of a Docker port publish is bound by dockerd, which
# already runs as root. Override only if this host already has something on 80.
HOST_PORT=80

# Which published image tag to run (issue #50). `latest` tracks main and
# auto-updates; pin to a specific build to freeze/rollback, e.g.
# IMAGE_TAG=sha-1a2b3c4 (then `docker compose pull && docker compose up -d`).
IMAGE_TAG=latest

# How often Watchtower checks GHCR for a newer image, in seconds (default ~20
# min). Set lower for faster rollouts, higher to check less often.
WATCHTOWER_POLL_INTERVAL=1200

# Docker API version Watchtower's client talks to the daemon. Needed because
# Watchtower otherwise negotiates an old version (1.25) that modern Docker
# Engine rejects, silently breaking auto-update. 1.40 is the daemon minimum;
# only change this if your daemon requires a higher floor.
DOCKER_API_VERSION=1.40

# Timezone for the info-screen clock (IANA name). Without this the container
# runs in UTC and the clock will be wrong. Examples: America/Chicago,
# America/New_York, Europe/London. Find yours: `timedatectl list-timezones`.
TZ=America/Chicago

# Boot display mode:
#   qlock = word clock (lightest on the Pi 3B+; no flip animation)
#   flip  = split-flap info screen (date + 24h clock)
DEFAULT_MODE=qlock

# State file path inside the container. Persisted on the `split-flap-data`
# Docker volume so the last message/mode/theme/sound survive restarts.
# Set to "off" to run fully in-memory (resets on restart).
PERSIST_FILE=/data/.state.json

# Split-flap animation speed. NOTE: baked into the client at BUILD time, so the
# published GHCR image is fixed at the default (3). This only applies when you
# build the image yourself via docker-compose.build.yml.
#   1 = original mechanical speed — gentlest on a Pi 3B+
#   3 = default (three times as fast; full-board changes settle within a rotation)
FLIP_SPEED=3

# ---------------------------------------------------------------------------
# MQTT + Home Assistant (issue #68). OFF unless MQTT_HOST is set — no broker
# configured means no client and no error.
#
# Publishes the appliance's own state (mode, theme, connected clients, active
# screens) plus a retained Last Will on <base>/status. The LWT is the point:
# this is the flakiest reporter in the fleet (WiFi through walls), and it is the
# host whose death nobody notices, because you find out by walking past it.
# The broker announces `offline` on its behalf when the connection drops.
#
# Board CONTENT is never published — pushing content to the board is
# POST /api/screens/<n>.
# MQTT_HOST=192.168.0.30
# MQTT_PORT=1883
# MQTT_USER=
# MQTT_PASS=
# MQTT_BASE_TOPIC=split_flap        # topic root + HA device identifier
# MQTT_DISCOVERY_PREFIX=homeassistant
